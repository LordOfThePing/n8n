# =============================================================================
# n8n + Cloudflare Tunnel deployment — environment template
# Copy this file to `.env` and fill in the values, then run:
#     ./scripts/provision-tunnel.ps1   (one-time tunnel + DNS setup)
#     docker compose up -d             (start n8n + cloudflared)
# =============================================================================

# ---- n8n --------------------------------------------------------------------
# Version tag of the n8n image to run.
N8N_VERSION=latest
# Local port to bind n8n to on 127.0.0.1 (change only if 5678 is taken).
N8N_LOCAL_PORT=5678
# Encryption key: set a long, random value. This encrypts n8n's stored
# credentials. MUST stay constant across restarts or stored credentials
# become unreadable. Generate with:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=

# ---- Cloudflare -------------------------------------------------------------
# API token. Must have (at least) on the flynnpedroa.engineer zone:
#   Zone            > Zone          > Read
#   Zone            > DNS           > Edit
#   Account         > Cloudflare Tunnel > Edit & Read
# Create one at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Name of the tunnel as shown in the Cloudflare dashboard.
TUNNEL_NAME=n8n-tunnel
# Cloudflare account tag (find in the dashboard URL after /account/).
CLOUDFLARE_ACCOUNT_TAG=
# Zone id for flynnpedroa.engineer (dashboard -> domain -> overview -> API zone id).
CLOUDFLARE_ZONE_ID=
# Hostname the tunnel is published under.
TUNNEL_HOSTNAME=n8n.flynnpedroa.engineer
