# =============================================================================
# n8n + Cloudflare Tunnel deployment — environment template
# Copy this file to `.env`, fill in the values, then run:
#     docker compose --env-file .env up -d
# =============================================================================

# ---- n8n --------------------------------------------------------------------
# Version tag of the n8n image to run.
N8N_VERSION=latest
# Local port to bind n8n to on 127.0.0.1 (change only if 5678 is taken).
N8N_LOCAL_PORT=5678
# Encryption key: set a long, random value. This encrypts n8n's stored
# credentials. MUST stay constant across restarts or stored credentials
# become unreadable. Generate with:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=

# ---- Cloudflare Tunnel --------------------------------------------------------
# Cloudflared's tunnel token (the `eyJ...` string). Find it in the dashboard:
# Networks -> Tunnels -> <your tunnel> -> Configure -> tab "Token".
# (Cloudflared service token: dashboard Networks -> Tunnels -> tunnel details.)
TUNNEL_TOKEN=

# ---- MongoDB (local) --------------------------------------------------------
# Root password for the local MongoDB container. Generate a strong random value
# (openssl rand -hex 16). MongoDB is bound to 127.0.0.1 only.
MONGO_ROOT_PASSWORD=
# MongoDB image major version (optional; defaults to 7).
MONGO_VERSION=7
# Database created on first start (optional; defaults to "whatsapp").
MONGO_INITIAL_DB=whatsapp
